---
import BaseLayout from "../layouts/BaseLayout.astro";

const tistoryUrl = "https://jeeeyuu.tistory.com/";
---

<BaseLayout
  title="Jiyu Lee: Blog"
  description="Jiyu Lee's Tistory blog, embedded live in the portfolio."
  sideBarActiveItemID="blog"
>
  <section class="blog-heading">
    <div>
      <p>WRITING · LIVE FROM TISTORY</p>
      <h1>Blog</h1>
      <span>This page displays the current Tistory blog directly.</span>
    </div>
    <a href={tistoryUrl} target="_blank" rel="noopener noreferrer">
      Open on Tistory <span aria-hidden="true">↗</span>
    </a>
  </section>

  <div class="browser-frame">
    <div class="browser-bar" aria-hidden="true">
      <div class="browser-dots"><i></i><i></i><i></i></div>
      <div class="browser-address">jeeeyuu.tistory.com</div>
      <span>LIVE</span>
    </div>
    <iframe
      src={tistoryUrl}
      title="Jiyu Lee's Tistory blog"
      loading="eager"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen
    ></iframe>
  </div>

  <p class="embed-note">
    If the embedded page does not appear in your browser, use the “Open on Tistory” button above.
  </p>
</BaseLayout>

<style>
  .blog-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:1.5rem}.blog-heading p{color:var(--pink);font-size:.68rem;font-weight:800;letter-spacing:.16em}.blog-heading h1{margin-top:.45rem;font-size:clamp(2.5rem,5vw,4rem);font-weight:720;letter-spacing:-.04em}.blog-heading div>span{display:block;margin-top:.4rem;color:var(--muted);font-size:.85rem}.blog-heading>a{flex:0 0 auto;border:1px solid var(--line);border-radius:999px;background:#fff;padding:.75rem 1rem;font-size:.8rem;font-weight:700;transition:transform 160ms ease,box-shadow 160ms ease}.blog-heading>a:hover{transform:translateY(-2px);box-shadow:0 10px 25px rgba(41,50,54,.07)}
  .browser-frame{overflow:hidden;border:1px solid var(--line);border-radius:1.15rem;background:#fff;box-shadow:0 18px 42px rgba(41,50,54,.08)}.browser-bar{display:grid;height:3.25rem;grid-template-columns:1fr minmax(220px,430px) 1fr;align-items:center;border-bottom:1px solid var(--line);background:#eef1f2;padding:0 1rem}.browser-dots{display:flex;gap:.38rem}.browser-dots i{width:.65rem;height:.65rem;border-radius:999px;background:#d8a1b0}.browser-dots i:nth-child(2){background:#dec36f}.browser-dots i:nth-child(3){background:#8eb8a5}.browser-address{overflow:hidden;border:1px solid #d9e0e2;border-radius:999px;background:#fff;padding:.42rem .9rem;color:var(--muted);font-size:.72rem;text-align:center;text-overflow:ellipsis;white-space:nowrap}.browser-bar>span{justify-self:end;color:var(--green);font-size:.62rem;font-weight:800;letter-spacing:.13em}.browser-frame iframe{display:block;width:100%;height:max(760px,78vh);border:0;background:#fff}.embed-note{margin-top:.8rem;color:var(--muted);font-size:.72rem;text-align:right}
  @media(max-width:640px){.blog-heading{align-items:start;flex-direction:column}.browser-bar{grid-template-columns:auto 1fr auto;gap:.7rem}.browser-address{min-width:0}.browser-frame iframe{height:72vh}.embed-note{text-align:left}}
</style>
