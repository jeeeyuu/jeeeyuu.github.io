---
const {
  title,
  img,
  desc,
  url,
  badge,
  tags,
  target = "_blank",
  subtleBadge = false,
} = Astro.props;
import { Image } from "astro:assets";
const isDisabled = !url || url === "#";
const tag_url = isDisabled ? "" : url.split("/").slice(0, -1).join("/") + "/tag";
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a
    href={isDisabled ? undefined : url}
    target={isDisabled ? undefined : target}
    class:list={[isDisabled && "cursor-default"]}
  >
    <div class="hero-content flex-col md:flex-row">
      {
        img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {
            badge && (
              <div
                class:list={[
                  "badge mx-2",
                  subtleBadge
                    ? "bg-white text-black border-gray-300 font-normal text-xs"
                    : "badge-secondary",
                ]}
              >
                {badge}
              </div>
            )
          }
        </h1>
        <p class="py-1 text-1xl" set:html={desc}></p>
        <div class="card-actions justify-end">
          {
            tags &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </a>
</div>
