---
const {
  title,
  img,
  desc,
  url,
  badge,
  tags,
  target = "_blank",
  subtleBadge = false,
} = Astro.props;
import { Image } from "astro:assets";
const isDisabled = !url || url === "#";
const tag_url = isDisabled ? "" : url.split("/").slice(0, -1).join("/") + "/tag";
const typedTags = tags as string[] | undefined;
---

<article class="horizontal-card">
  <a
    href={isDisabled ? undefined : url}
    target={isDisabled ? undefined : target}
    rel={!isDisabled && target === "_blank" ? "noopener noreferrer" : undefined}
    class:list={["horizontal-card-link", isDisabled && "cursor-default"]}
  >
    <div class="horizontal-card-content">
      {
        img && (
          <div class="horizontal-card-image">
            <Image src={img} width={750} height={422} format="webp" alt={title} />
          </div>
        )
      }
      <div class="horizontal-card-copy">
        <h2>
          {title}
          {
            badge && (
              <span
                class:list={[
                  "card-badge",
                  subtleBadge
                    ? "card-badge-subtle"
                    : "card-badge-accent",
                ]}
              >
                {badge}
              </span>
            )
          }
        </h2>
        <p class="horizontal-card-description" set:html={desc}></p>
        {!isDisabled && <span class="horizontal-card-arrow" aria-hidden="true">↗</span>}
      </div>
    </div>
  </a>
  {
    typedTags && typedTags.length > 0 && (
      <div class="horizontal-card-tags">
        {typedTags.map((tag) => <a href={`${tag_url}/${tag}`}>{tag}</a>)}
      </div>
    )
  }
</article>

<style>
  .horizontal-card{position:relative;overflow:hidden;border:1px solid var(--line);border-radius:1rem;background:var(--surface);transition:transform 160ms ease,box-shadow 160ms ease}
  .horizontal-card:hover{transform:translateY(-2px);box-shadow:0 14px 32px rgba(41,50,54,.07)}
  .horizontal-card-link{display:block;padding:1rem}.horizontal-card-content{display:flex;align-items:center;gap:1.3rem}.horizontal-card-image{width:14rem;flex:0 0 14rem;overflow:hidden;border-radius:.75rem;background:var(--sky-soft)}.horizontal-card-image :global(img){display:block;width:100%;height:8.4rem;object-fit:cover}
  .horizontal-card-copy{position:relative;min-width:0;flex:1;padding-right:2rem}.horizontal-card-copy h2{font-size:1.2rem;font-weight:720;line-height:1.3}.horizontal-card-description{margin-top:.55rem;color:var(--muted);font-size:.82rem;line-height:1.65}.horizontal-card-description :global(b){color:var(--ink);font-weight:650}.card-badge{display:inline-flex;align-items:center;margin-left:.55rem;border-radius:999px;padding:.22rem .55rem;vertical-align:middle;font-size:.66rem}.card-badge-subtle{border:1px solid var(--line);background:#fff;color:var(--ink);font-weight:500}.card-badge-accent{background:var(--pink-soft);color:#8d4f62;font-weight:700}.horizontal-card-arrow{position:absolute;top:0;right:0;color:var(--green);font-size:1rem}.horizontal-card-tags{display:flex;gap:.4rem;padding:0 1rem 1rem}.horizontal-card-tags a{border:1px solid var(--line);border-radius:999px;padding:.2rem .55rem;color:var(--muted);font-size:.65rem}
  @media(max-width:640px){.horizontal-card-content{align-items:stretch;flex-direction:column}.horizontal-card-image{width:100%;flex-basis:auto}.horizontal-card-image :global(img){height:auto;aspect-ratio:16/9}.horizontal-card-copy{padding:.2rem .3rem .4rem}.horizontal-card-arrow{right:.25rem}}
</style>
